# Container default. For local development, use a writable relative path such as ./data/finance.db.
DATABASE_PATH=/data/finance.db
PORT=3000
AUTO_SETUP_DATABASE=1

# Server-only current crypto market provider. Use keyless explicitly for local
# experiments; demo mode requires a CoinGecko Demo API key at runtime.
COINGECKO_MODE=demo
COINGECKO_API_KEY=

# Server-only dedicated Kraken Spot read-only credential. Required permissions:
# query-funds, query-ledger, query-closed-trades. Never grant write permissions.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Server-only Alchemy credential for fixed Ethereum/Base/Arbitrum Mainnet read-only sync.
# Talli accepts public addresses only and never signs or broadcasts transactions.
ALCHEMY_API_KEY=
